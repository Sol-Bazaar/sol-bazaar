# ═══════════════════════════════════════════════════════════════════════════
#  Sol Bazaar — environment configuration
# ═══════════════════════════════════════════════════════════════════════════
#  Copy to `.env` and fill in. NEVER commit the real .env.
#     cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  Database
# ───────────────────────────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://solbazaar:solbazaar_dev_password@localhost:5432/solbazaar?schema=public"

# ───────────────────────────────────────────────────────────────────────────
#  Core app
# ───────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# The domain merchants are served from. White-label tenants get
# <slug>.solbazaar.com, or map a custom domain to a Domain row.
BASE_DOMAIN="localhost:3000"

# Slug of the platform's own storefront (the fallback tenant).
HOUSE_TENANT_SLUG=sol-bazaar

# Canonical origin, used in emails and webhooks.
APP_URL="http://localhost:3000"

# Public + service name, used in structured logs.
SERVICE_NAME=sol-bazaar


# ───────────────────────────────────────────────────────────────────────────
#  SOLANA / CRYPTO PAYMENTS
# ───────────────────────────────────────────────────────────────────────────
# devnet | mainnet-beta | testnet | localnet
SOLANA_CLUSTER=devnet

# A single URL is enough for development. For mainnet use a dedicated provider
# (Helius / QuickNode / Triton) and comma-separate several URLs for failover —
# the pool round-robins and retries on a different node when one fails.
#   Helius:    https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   QuickNode: https://your-name.solana-mainnet.quiknode.pro/YOUR_TOKEN/
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_RPC_URLS=""
SOLANA_RPC_API_KEY=""
SOLANA_RPC_TIMEOUT_MS=15000
# WebSocket endpoint (optional; only used for advanced subscriptions).
SOLANA_WS_URL=""

# Poll interval for detecting incoming payments, in milliseconds.
# Solana blocks are ~400ms, so 5000ms gives ~2.5s average detection latency.
WATCHER_INTERVAL_MS=5000
WATCHER_BATCH=60

# Confirmations required before a payment counts as settled.
SOL_MIN_CONFIRMATIONS=32
SPL_MIN_CONFIRMATIONS=32

# Require full finality on top of the confirmation count. Keep true for real
# money: a transaction can be confirmed and then forked out.
REQUIRE_FINALIZED=true

# Accept payments that are short by up to this many basis points (1.5% = 150).
# Set to 0 to require the exact amount.
PAYMENT_TOLERANCE_BPS=150

# Add a small floor to the required amount so a customer can never fall short
# by a single base unit through rounding (10 bps of one token).
PAYMENT_DUST_BPS=10


# ───────────────────────────────────────────────────────────────────────────
#  PLATFORM FEE  (our cut — swept on-chain to the collector wallet)
# ───────────────────────────────────────────────────────────────────────────
# A percentage of each order line's face value, charged on top of the merchant's
# markup and accounted separately so it can be swept out and refunded precisely.
PLATFORM_FEE_BPS=100

# Where all accumulated platform fees are transferred on Solana.
# Verify this before going live: fees are irreversible once swept, and a typo
# here sends real money to an address nobody controls. The sweeper refuses to
# run if the value is not a valid Solana address.
PLATFORM_FEE_WALLET=EKCMKKGehtGp9UtYvAigogmbfBCHsSbMdMWLfsQNY8yZ

# Sweep once the unswept SOL balance crosses this (lamports). 5 SOL default.
# Batching many fees into one transaction costs one 5000-lamport signature fee
# instead of one per order, so sweeping less often is cheaper.
PLATFORM_FEE_MIN_SWEEP_SOL=5000000000

# Cap per sweep (lamports) so a single transfer never risks a very long blockhash
# wait or trips a size/limit guard on the collector wallet.
PLATFORM_FEE_MAX_SWEEP_SOL=250000000000

# Dedicated HD slots used to *send* fees. Must be far above the deposit range
# (which starts at 0) so a sweeping transfer can never be mistaken for a
# customer deposit by the payment watcher.
WALLET_SWEEP_INDEX_SOL=999000
WALLET_SWEEP_INDEX_SPL=999001

# How often the sweeper loop runs, in milliseconds.
FEE_SWEEP_INTERVAL_MS=900000

# Bearer token protecting /api/admin/fees. Generate with: openssl rand -hex 32
OPERATOR_TOKEN=


# ───────────────────────────────────────────────────────────────────────────
#  WALLET  ⚠  CRITICAL — THIS CONTROLS REAL FUNDS
# ───────────────────────────────────────────────────────────────────────────
# Generate a fresh seed:
#     npm run wallet:new
# and paste the encrypted value it prints. The plaintext seed must never be
# stored anywhere else.
#
# LOSS IMPACT: losing WALLET_SEED means you can no longer sweep or refund
# deposits. Store offline. Treat it exactly like a hardware-wallet backup.
WALLET_SEED=

# Highest derivation index the wallet will hand out. Refuses to derive past
# this as a guard against a runaway bug burning thousands of keypairs.
WALLET_MAX_INDEX=1000000

# Optional second seed, used ONLY to sign platform-fee sweeps. Deriving
# customer deposit addresses never signs, so isolating the sweeper means a
# compromise there cannot derive deposit addresses. Falls back to
# WALLET_SEED when unset. Generate: npm run wallet:sweep-new
#WALLET_SWEEP_SEED=v1.<salt>.<iv>.<tag>.<ciphertext>

# 32 random bytes. Encrypts the wallet seed and webhook secrets at rest.
#   openssl rand -hex 32
# Generate with: npm run keys:new
WALLET_MASTER_KEY=


# ───────────────────────────────────────────────────────────────────────────
#  CODE ENCRYPTION  ⚠  CRITICAL
# ───────────────────────────────────────────────────────────────────────────
# AES-256-GCM key for redeemable gift-card codes. Deliberately SEPARATE from
# WALLET_MASTER_KEY so leaking one does not compromise the other.
#   openssl rand -hex 32
#
# LOSS IMPACT: without this key, codes already delivered can never be
# re-displayed to customers. Back it up separately.
CODE_ENCRYPTION_KEY=


# ───────────────────────────────────────────────────────────────────────────
#  GIFT-CARD ISSUER
# ───────────────────────────────────────────────────────────────────────────
# Leave blank to use the built-in sandbox provider, which issues instantly and
# lets you exercise the full pipeline without spending money.
RECHARGE_API_KEY=
RECHARGE_BASE_URL="https://api.rechargeapps.com/v1"
RECHARGE_CURRENCY=USD

# Shared secret from the issuer's webhook dashboard. Required in production —
# without it the webhook endpoint refuses unsigned payloads.
RECHARGE_WEBHOOK_SECRET=

# Refuse to run the sandbox provider in production.
PROVIDER_REQUIRE_REAL=false

# Simulated issuer latency for the sandbox (ms).
MOCK_PROVIDER_LATENCY_MS=350


# ───────────────────────────────────────────────────────────────────────────
#  EMAIL DELIVERY
# ───────────────────────────────────────────────────────────────────────────
# resend | postmark. Leave blank in development and codes are logged instead.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Sol Bazaar <orders@solbazaar.com>"


# ───────────────────────────────────────────────────────────────────────────
#  RATE LIMITING
# ───────────────────────────────────────────────────────────────────────────
# Anonymous REST calls per minute, per IP.
RATE_LIMIT_PER_MIN=120
# Jobs per worker process.
JOB_CONCURRENCY=4
JOB_POLL_MS=1500


# ───────────────────────────────────────────────────────────────────────────
#  GEOLOCATION
# ───────────────────────────────────────────────────────────────────────────
# In production the CDN sets a country header (CF-IPCountry, x-vercel-ip-country,
# …) and no external lookup happens. Set false to disable IP lookups entirely.
GEO_IP_LOOKUP=true

# Used only when no CDN header and no IP lookup are available.
DEFAULT_COUNTRY=US

# Budget for the IP -> country lookup, in ms. Providers are raced, so this is the
# worst case, not the typical one. Raise it if detection feels unreliable on
# slow days; lower it if you put a CDN in front and never want to wait.
GEO_LOOKUP_TIMEOUT_MS=2500


# ───────────────────────────────────────────────────────────────────────────
#  PRIVACY / OPS
# ───────────────────────────────────────────────────────────────────────────
# Salt for one-way IP hashing in order records. Rotate invalidates history.
IP_HASH_SALT=change-me-to-a-long-random-string

# How long to wait for in-flight jobs on SIGTERM before exiting.
SHUTDOWN_GRACE_MS=8000

# ── WALLETCONNECT ────────────────────────────────────────────────────────
# Free projectId from https://cloud.reown.com — this is a PUBLIC client value,
# not a secret. Without it the WalletConnect option is hidden entirely; the
# rest of the wallet list is unaffected.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=