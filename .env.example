# Cryptorefills API
CRYPTOREFILLS_API_KEY=your_api_key_here
CRYPTOREFILLS_WEBHOOK_SECRET=your_webhook_secret_here
CRYPTOREFILLS_API_BASE=https://api.cryptorefills.com

# Solana / Crypto Payments
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_from_cloud_reown_com

# Your Platform Wallet (where 2% fee goes)
PLATFORM_FEE_WALLET=YOUR_SOLANA_WALLET_ADDRESS_HERE
PLATFORM_FEE_BPS=200

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GiftCard Store